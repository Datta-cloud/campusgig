# CampusGig Backend Environment Variables Example

# Database (PostgreSQL for Cloud Deploy / SQLite fallback)
DATABASE_URL=sqlite:///./campusgig.db
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# JWT Security
SECRET_KEY=generate_a_secure_random_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Cloud Object Storage (Supabase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=campusgig-deliverables

# Payment Gateway (Razorpay)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
